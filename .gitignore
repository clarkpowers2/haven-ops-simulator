# Environment files — real credentials live here, never commit
.env
.env.local
.env.production
.env.staging
.env.*.local

# Node
node_modules/
dist/
.cache/
supabase/.temp/

# Build output
out/
build/

# Logs — may contain sensitive info
*.log
logs/

# Simulator run output — stays local
reports/output/
*.audit.json

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp
