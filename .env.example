VITE_ENVIRONMENT=simulation

# Simulator Supabase — never use Haven production credentials
VITE_SIM_SUPABASE_URL=your_simulator_supabase_url_here
VITE_SIM_SUPABASE_ANON_KEY=your_simulator_supabase_anon_key_here
SIM_SUPABASE_SERVICE_KEY=your_simulator_supabase_service_key_here

# Protected Haven simulation intake endpoint
HAVEN_TEST_INTAKE_URL=your_haven_test_intake_url_here
HAVEN_SIMULATION_TOKEN=your_simulation_service_token_here

# Optional AI provider
AI_API_KEY=your_ai_api_key_here
AI_MODEL=claude-sonnet-4-6

# Optional telemetry
OTEL_EXPORTER_ENDPOINT=your_otel_endpoint_here
OTEL_SERVICE_NAME=haven-ops-simulator
